<UserControl x:Class="MyChess.Controls.EngineOutputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2">
            <TextBlock Name="CalculatingText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0"
                       FontWeight="Bold" Foreground="DarkRed" Visibility="Collapsed">Berechne...</TextBlock>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="Bold">Line:</TextBlock>
            <TextBox Name="LineText" IsReadOnly="True" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer>
            <TextBlock Name="OutputText" VerticalAlignment="Top" HorizontalAlignment="Left">
                EngineOutputControl
            </TextBlock>
        </ScrollViewer>
    </DockPanel>
</UserControl>
